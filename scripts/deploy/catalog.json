{
  "schemaVersion": 1,
  "repository": "dvorovrus/Generals-Mac-iOS-iPad",
  "workspace": {
    "inputs": "../input",
    "shell": "../shell",
    "localOutputs": "../output",
    "artifacts": "../artifacts",
    "ipadLogs": "../output/logs"
  },
  "variants": {
    "ipad": {
      "original": {
        "title": "Original Zero Hour",
        "status": "stable",
        "branch": "main",
        "buildMode": "github",
        "workflow": "build-ipad.yml",
        "artifact": "GeneralsZH-iPad-unsigned",
        "artifactFile": "GeneralsZH-iPad-unsigned.ipa",
        "installReady": true,
        "installMode": "sideloadly",
        "localFallbackScript": "scripts/build/ios/windows/build-original.ps1",
        "localOutput": "GeneralsZH-Original-unsigned.ipa"
      },
      "contra": {
        "title": "Contra X Beta 2 + Patch 1",
        "status": "stable",
        "branch": "main",
        "buildMode": "github",
        "workflow": "build-ios-contra.yml",
        "artifact": "GeneralsZH-ContraX-iPad-unsigned",
        "artifactFile": "GeneralsZH-ContraX-unsigned.ipa",
        "installReady": true,
        "installMode": "sideloadly",
        "localFallbackScript": "scripts/build/ios/windows/build-contra.ps1",
        "localOutput": "GeneralsZH-ContraX-unsigned.ipa"
      },
      "enhanced": {
        "title": "Zero Hour Enhanced",
        "status": "stable",
        "branch": "main",
        "buildMode": "github",
        "workflow": "build-ios-enhanced.yml",
        "artifact": "GeneralsZH-Enhanced-iPad-unsigned",
        "artifactFile": "GeneralsZH-Enhanced-unsigned.ipa",
        "installReady": true,
        "installMode": "sideloadly",
        "localFallbackScript": "scripts/build/ios/windows/build-enhanced.ps1",
        "localOutput": "GeneralsZH-Enhanced-unsigned.ipa"
      },
      "all": {
        "title": "All-in-One: Original + Enhanced + Contra X",
        "status": "stable-local",
        "branch": "ios-clean",
        "buildMode": "local",
        "workflow": null,
        "artifact": null,
        "artifactFile": "GeneralsZH-AllInOne-unsigned.ipa",
        "installReady": true,
        "installMode": "sideloadly",
        "localFallbackScript": "scripts/build/ios/windows/build-all.ps1",
        "localOutput": "GeneralsZH-AllInOne-unsigned.ipa"
      },
      "online": {
        "title": "Generals Online",
        "status": "experimental",
        "branch": "feature/generals-online-apple",
        "buildMode": "github",
        "workflow": "build-ios-online.yml",
        "artifact": "GeneralsXZH-online-unsigned",
        "artifactFile": "GeneralsXZH-online-unsigned.ipa",
        "installReady": false,
        "installMode": "sideloadly",
        "note": "Current Online artifact is an engine shell without retail GameData. Treat it as a test build, not a normal end-user full IPA."
      }
    },
    "macos": {
      "original": {
        "title": "Original Zero Hour",
        "status": "stable",
        "branch": "main",
        "buildMode": "github",
        "workflow": "build-macos.yml",
        "artifact": "macos-generalsxzh-app",
        "artifactFile": "GeneralsXZH.tar",
        "appName": "GeneralsXZH.app",
        "installReady": true,
        "installMode": "app-bundle",
        "dataMode": "gamedata",
        "dataRoot": "~/GeneralsX/GeneralsZH",
        "logPath": "repo/logs/run_zh_macos.log"
      },
      "contra": {
        "title": "Contra X Beta 2 + Patch 1",
        "status": "stable",
        "branch": "ios-clean",
        "buildMode": "github",
        "workflow": "build-macos-contra-dev.yml",
        "artifact": "GeneralsZH-ContraX-macos-arm64",
        "artifactFile": "GeneralsZH-ContraX-macos-arm64.tar",
        "appName": "GeneralsZH-ContraX-Dev.app",
        "installReady": true,
        "installMode": "app-bundle",
        "dataMode": "gamedata+profile",
        "dataRoot": "~/GeneralsX/GeneralsZH",
        "profile": "contra-x",
        "profileRoot": "~/GeneralsX/ContraX",
        "logPath": "~/Library/Logs/GeneralsXZH/contra-dev.log"
      },
      "online": {
        "title": "Generals Online",
        "status": "experimental",
        "branch": "feature/generals-online-apple",
        "buildMode": "github",
        "workflow": "build-macos-online.yml",
        "artifact": "GeneralsZH-Online-macos-arm64",
        "artifactFile": "GeneralsZH-Online-macos-arm64.tar",
        "appName": "GeneralsZH-Online-Dev.app",
        "installReady": true,
        "installMode": "app-bundle",
        "dataMode": "gamedata",
        "dataRoot": "~/GeneralsX/Online/GeneralsZH",
        "logPath": "~/Library/Logs/GeneralsXZH/online-dev.log"
      },
      "enhanced": {
        "title": "Zero Hour Enhanced",
        "status": "not-supported",
        "branch": null,
        "buildMode": "none",
        "installReady": false,
        "note": "No maintained macOS Enhanced build exists yet."
      },
      "all": {
        "title": "All-in-One",
        "status": "not-supported",
        "branch": null,
        "buildMode": "none",
        "installReady": false,
        "note": "All-in-One is an iPad packaging profile only."
      }
    }
  },
  "internal": {
    "ipadEngineShell": {
      "branch": "ios-clean",
      "workflow": "build-ios-shell.yml",
      "artifact": "GeneralsXZH-launcher-unsigned"
    },
    "ipadLauncherFast": {
      "branch": "ios-clean",
      "workflow": "build-ios-launcher-fast.yml",
      "artifact": "GeneralsXZH-launcher-unsigned"
    }
  }
}
